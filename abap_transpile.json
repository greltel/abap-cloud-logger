{
  "input_folder": "src",
  "input_filter": [
    "zcl_cloud_logger.clas",
    "zcl_cloud_logger_persistence",
    "zcl_cloud_logger_system",
    "zcl_cloud_logger_view_alv",
    "zcx_cloud_logger_error",
    "zcx_cloud_logger_message",
    "zif_cloud_logger",
    "zif_cloud_logger_persistence",
    "zif_cloud_logger_system",
    "zif_cloud_logger_viewer",
    "z_cloud_logger.msag"
  ],
  "output_folder": "output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-rap"
    },
    {
      "url": "https://github.com/open-abap/open-abap-bal"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui"
    },
    {
      "url": "https://github.com/open-abap/open-abap-xco"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError",
    "skip": [
      {
        "object": "ZCL_CLOUD_LOGGER",
        "class": "LTC_CLOUD_LOGGER",
        "method": "GIVEN_UNKNOWN_OBJECT_RAISES",
        "note": "open-abap-bal does not yet validate application log objects, APLO"
      }
    ]
  }
}
